# ML-Server-Recommedations — environment variables
# Copy to .env and fill in before running locally or in a container.

# ----- Data paths -----
# Where Saving_recom.py writes its final CSVs, and where API2.py reads from.
# In Docker: mount a persistent volume at /app/data and set this to /app/data.
# Locally: leave unset to default to ./data/ next to the scripts.
DATA_DIR=/app/data

# Where Fetch_params → Merging → recom7_2 write intermediate files.
# Leave unset to use ./input_params/ (relative to scripts) — usually fine.
# PIPELINE_DIR=/app/input_params

# Full path to the Google Ads geo-targets lookup CSV.
# Download from: https://developers.google.com/google-ads/api/data/geotargets
GEOTARGETS_PATH=/app/data/geotargets.csv

# ----- Google Ads API -----
# Copy from google-ads.yaml or set directly here.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ----- Flask -----
# Set to "production" in prod; never run debug=True in a container.
FLASK_ENV=production
